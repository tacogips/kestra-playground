POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=kestra
BATCH_DB=ecommerce_ops
BATCH_DB_USER=ecommerce_batch
BATCH_DB_PASSWORD=ecommerce_batch
AFFILIATE_KESTRA_DB=kestra_affiliate

# local/docker/start.sh passes this file to docker compose with --env-file and
# unsets the same keys in the shell environment, so values set here win over
# exported variables.
#
# The EC Kestra image must match the lineage that already migrated the local
# kestra database. Use the tacogips/kestra fork build (Kestra 2) for the flows in
# kestra/flows-notification; starting the official 1.x image against a database
# migrated by Kestra 2 fails with `type "queue_type" does not exist`.
# EC_KESTRA_IMAGE=tacogips-kestra:latest

