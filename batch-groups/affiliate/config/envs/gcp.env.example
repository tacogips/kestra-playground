# Non-secret GCP deployment defaults. PROJECT_ID and LIVE_DOMAIN_NAME are
# injected through kinko or CI, and secret payloads stay in Secret Manager.
#
# Development doubles as staging and runs one shared Kestra on GKE for both batch
# groups, so the affiliate group targets the same endpoint and Basic Auth secrets
# as the EC group. Point LIVE_KESTRA_SUBDOMAIN and KESTRA_AUTH_SECRET_PREFIX at a
# dedicated affiliate deployment once one exists.
LIVE_KESTRA_SUBDOMAIN=k8s
KESTRA_AUTH_SECRET_PREFIX=kestra-dev-gke
KESTRA_AUTH_SOURCE=secret-manager
