KESTRA_DB_URL=jdbc:postgresql://kestra-postgres:5432/kestra_affiliate
KESTRA_DB_USERNAME=kestra
KESTRA_DB_PASSWORD=kestra
KESTRA_URL=http://localhost:8082/
KESTRA_STORAGE_TYPE=local
KESTRA_LOCAL_STORAGE_PATH=/app/storage
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
KESTRA_BASIC_AUTH_PASSWORD=KestraDev1234!
KESTRA_SERVER_BASIC__AUTH_USERNAME=admin@example.com
KESTRA_SERVER_BASIC__AUTH_PASSWORD=KestraDev1234!

ENV_BATCH_DB_URL=jdbc:postgresql://kestra-postgres:5432/ecommerce_ops
ENV_BATCH_DB_USERNAME=ecommerce_batch
ENV_BATCH_DB_PASSWORD=ecommerce_batch

# Mock SMTP sink provided by local/docker/docker-compose.yml (Mailpit).
# Kestra exposes ENV_-prefixed variables as {{ envs.* }} inside flows.
ENV_NOTIFY_SMTP_HOST=mailpit
ENV_NOTIFY_SMTP_PORT=1025
ENV_NOTIFY_MAIL_FROM=kestra-affiliate@playground.local
ENV_NOTIFY_MAIL_TO=ops@playground.local
