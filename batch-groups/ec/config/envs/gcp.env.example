# Non-secret GCP deployment defaults. PROJECT_ID and LIVE_DOMAIN_NAME are
# injected through kinko or CI, and secret payloads stay in Secret Manager.
LIVE_KESTRA_SUBDOMAIN=k8s
KESTRA_AUTH_SECRET_PREFIX=kestra-dev-gke
KESTRA_AUTH_SOURCE=secret-manager

# Private Python registry (GCP Artifact Registry) for kestra-batch-common.
# Staging/production workers resolve the shared batch library from here;
# local environments use the working-tree source instead.
PYTHON_REGISTRY_REGION=asia-northeast1
PYTHON_REGISTRY_REPOSITORY=python-batch-libs
# Derived as https://${PYTHON_REGISTRY_REGION}-python.pkg.dev/${PROJECT_ID}/${PYTHON_REGISTRY_REPOSITORY}/simple/
# PYTHON_REGISTRY_INDEX_URL=
