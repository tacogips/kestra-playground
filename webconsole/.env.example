# Copy to webconsole/.env for local development. Never commit real values.
# The deployed Cloud Run service reads the same variables from Secret Manager;
# see scripts/setup-webconsole-secrets.sh and scripts/deploy-webconsole.sh.

# "google" in production. "disabled" bypasses login for local development only.
AUTH_MODE=disabled

# Google OAuth 2.0 web client (required when AUTH_MODE=google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed to sign in. Keep out of git.
ALLOWED_EMAILS=

# Random string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Public URL of this app; used for the OAuth redirect URI.
APP_BASE_URL=http://localhost:8787

# On-premise Kestra API connection.
KESTRA_URL=http://localhost:8080
KESTRA_TENANT=main
KESTRA_NAMESPACE=playground.ecommerce
KESTRA_FLOW_IDS=generate_ecommerce_mock_data,build_ecommerce_daily_report,build_ecommerce_customer_segments
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
KESTRA_BASIC_AUTH_PASSWORD=

PORT=8787
